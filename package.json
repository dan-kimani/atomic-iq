{
  "name": "atomiciq",
  "version": "0.0.7",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile apk --local --output ./build/atomiciq.apk",
    "build:android:aab": "eas build -p android --profile aab --local --output ./build/atomiciq.aab",
    "install:aab": "./scripts/install-aab.sh",
    "build:ios": "eas build -p ios --local",
    "build:android:release": "eas build -p android",
    "build:ios:release": "eas build -p ios",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.23",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "^58.0.19",
    "expo-blur": "^58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "^58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-country-picker-modal": "^3.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-gesture-handler"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
